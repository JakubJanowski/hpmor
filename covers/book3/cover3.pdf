         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Quote</photoshop:LayerName>
                  <photoshop:LayerText>"The universe is neither evil, nor good,                       it simply does not care.                    The stars don't care, or the Sun, or the sky.                    But they don't have to!                                     We care!                     There is light in the world,                                       and it is us!"  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Harry James Potter-Evans-Verres </photoshop:LayerName>
                  <photoshop:LayerText>Harry James Potter-Evans-Verres and the   Shadows of Death</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Harry Potter and the Methods of </photoshop:LayerName>
                  <photoshop:LayerText>Harry Potter and the Methods of Rationality</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Shadows of Death </photoshop:LayerName>
                  <photoshop:LayerText>Shadows of Death</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>       and the </photoshop:LayerName>
                  <photoshop:LayerText>       and the</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>HJPEV</photoshop:LayerName>
                  <photoshop:LayerText>Harry James Potter-Evans-Verres</photoshop:LayerText>
               </rdf:li>
